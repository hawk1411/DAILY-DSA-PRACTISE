class Solution {
  public:
    void rotateMatrix(vector<vector<int>>& mat) {
        // code here
    int m = mat.size();
    vector<vector<int>> man(m,vector<int>(m));
    for(int i=0;i<m;i++){
        for(int j=0;j<m;j++){
            man[m-j-1][i] = mat[i][j];
        }
    }
    mat = man;
    }
};
